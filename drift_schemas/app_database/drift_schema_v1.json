          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL UNIQUE, \"type\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, CHECK (type BETWEEN 0 AND 3), CHECK (length(trim(name)) BETWEEN 1 AND 80), CHECK (length(trim(normalized_name)) > 0));"
