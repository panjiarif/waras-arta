  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL UNIQUE, \"type\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, CHECK (type BETWEEN 0 AND 3), CHECK (length(trim(name)) BETWEEN 1 AND 80), CHECK (length(trim(normalized_name)) > 0));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"parent_id\" INTEGER NULL REFERENCES categories (id) ON DELETE RESTRICT, \"kind\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"system_key\" TEXT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (kind IN (0, 1)), CHECK (parent_id IS NULL OR parent_id <> id), CHECK (length(trim(name)) BETWEEN 1 AND 80), CHECK (length(trim(normalized_name)) BETWEEN 1 AND 80), CHECK (length(trim(icon_key)) BETWEEN 1 AND 40), CHECK (sort_order BETWEEN 0 AND 1000000), CHECK (system_key IS NULL OR length(trim(system_key)) BETWEEN 1 AND 80));"
        }
      ]
    },
    {
      "name": "ledger_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" INTEGER NOT NULL, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id), \"destination_account_id\" INTEGER NULL REFERENCES accounts (id), \"amount\" INTEGER NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"occurred_day\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, CHECK (kind BETWEEN 0 AND 3), CHECK (\n      (kind IN (0, 1, 2) AND amount BETWEEN 1 AND 999999999999)\n      OR (kind = 3 AND amount BETWEEN -999999999999 AND 999999999999\n        AND amount <> 0)\n    ), CHECK (occurred_day BETWEEN 20000101 AND 99991231), CHECK (length(note) <= 500), CHECK (\n      (kind IN (0, 1) AND destination_account_id IS NULL)\n      OR (kind = 2 AND destination_account_id IS NOT NULL\n        AND destination_account_id <> account_id)\n      OR (kind = 3 AND destination_account_id IS NULL)\n    ));"
        }
      ]
    },
    {
      "name": "ledger_allocations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_allocations\" (\"entry_id\" INTEGER NOT NULL REFERENCES ledger_entries (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"amount\" INTEGER NOT NULL, PRIMARY KEY (\"entry_id\", \"position\"), UNIQUE (\"entry_id\", \"category_id\"), CHECK (position BETWEEN 0 AND 49), CHECK (amount BETWEEN 1 AND 999999999999));"
        }
      ]
    }
